{
  "name": "house-maintenance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "api",
    "apps/web",
    "packages/shared",
    "packages/server-lib"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:server-lib": "npm run build --workspace=packages/server-lib",
    "vercel-build": "npm run build:shared && npm run build:server-lib && npm run build:web",
    "build:internal-packages": "npm run build:shared && npm run build:server-lib",
    "typecheck": "npm run build:internal-packages && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run build:internal-packages && npm run test --workspaces --if-present",
    "db:migrate": "node db/migrate.mjs",
    "db:seed-user": "node db/seed-user.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
