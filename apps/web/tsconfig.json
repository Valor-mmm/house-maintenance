{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"]
  },
  // src/sw.ts is checked by tsconfig.worker.json instead: it needs the
  // WebWorker lib, which can't coexist with DOM in one program.
  "include": ["src"],
  "exclude": ["src/sw.ts"]
}
